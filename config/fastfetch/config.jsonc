{   
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": "~/.config/fastfetch/logo",
    "display": {
      "separator": " "
    },
    "modules": [
	"break",
        {
            "type": "title"
        },
        {
            "type": "os",
            "key": "os  ",
            "format": "red hat agent"
        },
        {
            "type": "command",
            "key": "ker ",
            "shell": "/bin/sh",
            "text": "sh -c \"echo -n 'linux '; uname -r | cut -d'-' -f1\""
        },
        {
            "type": "os",
            "key": "wm  ",
            "format": "hyprland"
        },
        {
            "type": "shell",
            "key": "sh  ",
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "mem ",
            "text": "free -m | awk 'NR==2{printf \"%dm .. %dm\",$3,$2}'",
            "format": ""
        },
        "break"
    ]
}
